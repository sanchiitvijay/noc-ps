# NOC Automation Backend — Environment Variables
# Copy this file to .env and fill in the real values.

# ── Database ──────────────────────────────────────────────────────────────────
# Path to the SQLite database (use absolute path)
DATABASE_URL=sqlite:////Users/sanchitvijay/working/noc-ps/noc-automation2.db

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── LLM / Gemini ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ── Diagnostics ───────────────────────────────────────────────────────────────
# Set to False to run real ping/traceroute/nslookup system commands
FAKE_DIAGNOSTICS=True
# Optional: URL of a remote diagnostics service (unused when FAKE_DIAGNOSTICS=True)
REAL_DIAGNOSTIC_ENDPOINT=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins; use ["*"] for development
CORS_ORIGINS=["*"]

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Development Route & SQL Query logging (appends complete route and query details to log.txt)
DEV_LOG_ENABLED=True
DEV_LOG_FILE=log.txt

# ── Ingest ────────────────────────────────────────────────────────────────────
MAX_INGEST_FILE_SIZE_MB=100

# ── Default Admin (first-run only) ────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
